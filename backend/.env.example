# 复制为 backend/.env 后按实际部署修改（.env 已被 git 忽略，不会入库）

# ===== 运行环境 =====
NODE_ENV=production
PORT=3001

# ===== 鉴权 =====
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 要求：64 位十六进制字符串；留空时生产环境会拒绝启动（config/config.js）
JWT_SECRET=<替换为 64 位随机十六进制字符串>

# ===== 跨域白名单 =====
# 逗号分隔，逐项精确匹配（协议 + 域名 + 端口），不要使用 * 通配符
# 留空时默认 http://localhost:3000,http://localhost:3001,http://localhost:5173
CORS_ORIGINS=https://your-domain.example,https://www.your-domain.example

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webclone
DB_USER=postgres
DB_PASSWORD=<替换为数据库口令>
